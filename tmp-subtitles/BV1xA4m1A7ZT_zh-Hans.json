{"body":[{"from":3.366,"to":5.433,"location":0,"content":"欢迎回到Godot游戏实验室。"},{"from":5.866,"to":9.4,"location":0,"content":"在这段视频中，我们将创建本项目的基础部分"},{"from":9.633,"to":11,"location":0,"content":"卡片拖动机制。"},{"from":11.7,"to":13.633,"location":0,"content":"在《杀戮尖塔》这款游戏中"},{"from":13.866,"to":15.5,"location":0,"content":"我们有两种类型的卡片"},{"from":15.933,"to":17.733,"location":0,"content":"一种是单目标指向型"},{"from":17.966,"to":20,"location":0,"content":"另一种是 非单目标指向型。"},{"from":20.766,"to":23.133,"location":0,"content":"我们先从较为简单的那一种开始。"},{"from":23.9,"to":26.066,"location":0,"content":"如果我开始拖动这张“防守”卡"},{"from":26.066,"to":28.4,"location":0,"content":"并在手牌上方某个位置释放它"},{"from":28.4,"to":30.2,"location":0,"content":"那么这张卡就会被使用。"},{"from":31.566,"to":33.333,"location":0,"content":"还有一种实现方式是"},{"from":33.333,"to":35.9,"location":0,"content":"先用左键点击一下这张“防守”卡"},{"from":35.9,"to":38.933,"location":0,"content":"然后在不按住左键的情况下移动鼠标"},{"from":38.933,"to":41.233,"location":0,"content":"再次点击时也可以完成放置。"},{"from":42.366,"to":45.466,"location":0,"content":"此外，取消拖动动作也有两种方法。"},{"from":47.233,"to":52.533,"location":0,"content":"你可以通过右键点击或者将卡片拖动至游戏区域下方来取消此次操作。"},{"from":53.366,"to":56.933,"location":0,"content":"现在让我们看看在我们的游戏中是如何运作的。"},{"from":57.166,"to":61.1,"location":0,"content":"你可以看到我们在顶部有一个很大的卡片放置区域"},{"from":61.1,"to":63.9,"location":0,"content":"并且手中有三张处于初始状态的卡片。"},{"from":64.966,"to":70.666,"location":0,"content":"当我将鼠标悬停在一张卡片上并左键单击一次时，卡片会进入拖动状态"},{"from":71.166,"to":74.566,"location":0,"content":"我可以将卡片拖动到卡片放置区域上方"},{"from":75,"to":78.866,"location":0,"content":"当我再次用左键点击时，卡片会被释放"},{"from":79.666,"to":85.2,"location":0,"content":"并且我们能看到一条提示信息：“在目标的卡片放置区域内使用卡片”。"},{"from":85.966,"to":86.8,"location":0,"content":"非常好。"},{"from":87.733,"to":89.6,"location":0,"content":"如果我们拖动另一张卡片"},{"from":90,"to":94.266,"location":0,"content":"并在卡片放置区域下方释放，它会自动回到玩家的手牌中。"},{"from":95.233,"to":98.033,"location":0,"content":"同样地，如果我开始拖动这张卡片"},{"from":98.033,"to":101.233,"location":0,"content":"将其拖过卡片放置区域后再右键点击"},{"from":101.233,"to":102.966,"location":0,"content":"它也会回到玩家的手牌中。"},{"from":104.2,"to":105.866,"location":0,"content":"这一功能运行良好。"},{"from":106.6,"to":108.066,"location":0,"content":"我们开始着手制作吧。"},{"from":108.966,"to":112.233,"location":0,"content":"打开项目，我们开始创建卡片拖动机制。"},{"from":112.7,"to":116.633,"location":0,"content":"对于卡片本身，我们将结合使用控制节点来展示它们"},{"from":116.966,"to":120.933,"location":0,"content":"并使用一个二维区域节点来处理卡片放置区域的逻辑。"},{"from":122.5,"to":125.866,"location":0,"content":"首先，点击这个加号，新建一个场景。"},{"from":126.833,"to":131.1,"location":0,"content":"我们从用户界面节点作为根节点开始，添加一个控制节点。"},{"from":131.833,"to":134.933,"location":0,"content":"点击它，然后将其重命名为 CardUI"},{"from":136.466,"to":140.033,"location":0,"content":"接下来，我们需要在这个节点下添加两个子节点"},{"from":140.533,"to":142.533,"location":0,"content":"点击加号或按 Control+A"},{"from":143.233,"to":145.866,"location":0,"content":"首先我们添加一个颜色矩形节点。"},{"from":146.4,"to":149.133,"location":0,"content":"这个颜色矩形将作为一个临时颜色"},{"from":149.133,"to":153.2,"location":0,"content":"以便我们在调试阶段能够通过视觉差异区分不同的状态。"},{"from":154.933,"to":157.1,"location":0,"content":"将颜色矩形重命名为 Color"},{"from":159.8,"to":162.133,"location":0,"content":"然后再选中 CardUI 这个根节点"},{"from":162.866,"to":166,"location":0,"content":"再次点击加号，添加一个标签节点。"},{"from":168.566,"to":171.7,"location":0,"content":"点击标签节点并将其重命名为 State"},{"from":173.066,"to":176.533,"location":0,"content":"现在让我们放大一些，以便更好地查看情况。"},{"from":178.766,"to":181.3,"location":0,"content":"我们给 Card UI 设置一个合适的大小。"},{"from":182,"to":183.566,"location":0,"content":"转到布局（Layout）"},{"from":184.733,"to":186.033,"location":0,"content":"变换（Transform）"},{"from":186.966,"to":190.5,"location":0,"content":"将尺寸设置为类似 25乘以30这样的大小。"},{"from":193.433,"to":195.9,"location":0,"content":"这样看起来就像一张卡片的样子。"},{"from":197.5,"to":200.566,"location":0,"content":"接下来，确保颜色节点也继承这个大小。"},{"from":203.1,"to":204.366,"location":0,"content":"选择颜色节点"},{"from":205.766,"to":208.566,"location":0,"content":"然后在“锚点预设”中选择“整个矩形”"},{"from":211.466,"to":216.333,"location":0,"content":"在此期间，我们可以将颜色改为更为悦目的色彩，比如深绿色。"},{"from":219.433,"to":221.633,"location":0,"content":"那么，我们选择一个深绿色"},{"from":223.8,"to":225.033,"location":0,"content":"就像这样的颜色。"},{"from":226.266,"to":227.533,"location":0,"content":"对于state标签"},{"from":228.6,"to":230.933,"location":0,"content":"只需在文本属性中输入“state”"},{"from":232.533,"to":235.733,"location":0,"content":"并确保其在水平和垂直轴上都居中对齐。"},{"from":239.1,"to":242.966,"location":0,"content":"同时，请确保标签节点是从父节点继承尺寸。"},{"from":244.766,"to":247.733,"location":0,"content":"再次点击锚点预设并设置为全矩形。"},{"from":248.766,"to":251.7,"location":0,"content":"可以看到文本比卡片本身要大很多"},{"from":251.7,"to":253.866,"location":0,"content":"这是我们接下来需要解决的问题。"},{"from":254.9,"to":258.6,"location":0,"content":"好的，我们或许可以添加一个新的“标签设置资源”"},{"from":259.3,"to":260.733,"location":0,"content":"或者转到主题覆盖"},{"from":261.4,"to":264.266,"location":0,"content":"在字体大小设置中更改这里的字体大小。"},{"from":265.633,"to":270.133,"location":0,"content":"但我们并不希望为游戏中显示的每一个文本单独进行这样的操作。"},{"from":270.6,"to":273.066,"location":0,"content":"依靠主题来统一设置会更加简便。"},{"from":274.066,"to":276.3,"location":0,"content":"所以我们来创建一个新的主题。"},{"from":276.6,"to":279.033,"location":0,"content":"在文件系统中选择根目录"},{"from":279.5,"to":283.4,"location":0,"content":"右键点击，选择“创建新资源”并搜索 theme"},{"from":286.2,"to":289.633,"location":0,"content":"添加新的主题，并将其命名为 \"main_theme\""},{"from":291.166,"to":292.2,"location":0,"content":"点击保存"},{"from":293.566,"to":296.2,"location":0,"content":"你会看到屏幕底部出现了主题面板"},{"from":297.4,"to":300.433,"location":0,"content":"里面充满了各种设置、预览等选项"},{"from":301.366,"to":303.3,"location":0,"content":"但我们现在还不需要那些内容"},{"from":304.733,"to":307.933,"location":0,"content":"因为在右侧的检查器中我们可以看到主题的属性"},{"from":308.466,"to":311.166,"location":0,"content":"其中包括默认字体和默认字体大小。"},{"from":312.433,"to":315.066,"location":0,"content":"很好，现在我们展开art文件夹"},{"from":315.833,"to":319.6,"location":0,"content":"查找 pixel_rpg 字体，并将其拖拽至默认字体处。"},{"from":321.066,"to":324.2,"location":0,"content":"此时你会发现所有预览都已经发生变化"},{"from":325.033,"to":328.733,"location":0,"content":"但由于我们的分辨率很小，我们需要更小的字体大小。"},{"from":329.6,"to":333.666,"location":0,"content":"因此，在默认字体大小属性中，我们将它改为比如6。"},{"from":335.4,"to":337.433,"location":0,"content":"可以看到字体变小了很多。"},{"from":338.233,"to":341.5,"location":0,"content":"可以通过再次点击主题来关闭这个主题窗口"},{"from":343.333,"to":346.6,"location":0,"content":"你会发现 Card UI 场景并未发生什么变化。"},{"from":347.066,"to":347.7,"location":0,"content":"为什么呢？"},{"from":348.233,"to":351.733,"location":0,"content":"那是因为我们必须将这个主题分配给控制节点。"},{"from":352.433,"to":356.366,"location":0,"content":"所以，我们选择 CardUI 节点，并展开theme属性"},{"from":357.633,"to":360.566,"location":0,"content":"可以看到这里有一个用于设置主题的属性。"},{"from":361.066,"to":363.1,"location":0,"content":"我们可以直接像之前那样"},{"from":363.1,"to":365.733,"location":0,"content":"将主题资源从左侧拖放到右侧"},{"from":366.3,"to":368.766,"location":0,"content":"但有时候只需点击这个下拉菜单"},{"from":368.966,"to":371.133,"location":0,"content":"选择快速加载会更加简便。"},{"from":371.866,"to":374.8,"location":0,"content":"你会发现已经有匹配的主题供我们选择了。"},{"from":375.566,"to":376.533,"location":0,"content":"点击“打开”"},{"from":377.2,"to":381.066,"location":0,"content":"然后就能看到，字体现在已经完美适应了卡片的大小。"},{"from":382.866,"to":385.8,"location":0,"content":"我们需要保存这个场景，它还没有保存。"},{"from":387.7,"to":389.1,"location":0,"content":"进入 scenes 文件夹"},{"from":389.866,"to":393.166,"location":0,"content":"再创建一个新文件夹，命名为 card_ui"},{"from":394.233,"to":395.666,"location":0,"content":"然后点击保存"},{"from":396.666,"to":399.4,"location":0,"content":"我们还需要添加一个 Area2D 节点"},{"from":399.4,"to":402.533,"location":0,"content":"以便检测是否位于卡片放置区域上方。"},{"from":403.433,"to":407.366,"location":0,"content":"确保根节点被选中，点击加号或按 Control+A"},{"from":407.833,"to":410.066,"location":0,"content":"然后搜索Area2D 并添加"},{"from":412.8,"to":415.333,"location":0,"content":"将其重命名为 DropPointDetector"},{"from":419.5,"to":422.366,"location":0,"content":"接下来，我们来配置这个Area2D节点。"},{"from":422.933,"to":425.633,"location":0,"content":"在Area2D节点顶部有两个属性"},{"from":426,"to":429.933,"location":0,"content":"分别是监视（monitoring），和可被监视（monitorable）"},{"from":430.833,"to":433.6,"location":0,"content":"对于我们的需求，我们需要开启监视"},{"from":434.066,"to":437.533,"location":0,"content":"因为我们想要检测是否位于卡片放置区域上。"},{"from":438.866,"to":441.9,"location":0,"content":"而 Card U I 自身，将会负责处理这一交互。"},{"from":442.666,"to":446.3,"location":0,"content":"因此，在这种情况下，“可被监视”可以关闭。"},{"from":447.133,"to":448.4,"location":0,"content":"在碰撞设置下"},{"from":449.3,"to":451,"location":0,"content":"我们可以设定层和遮罩"},{"from":452.166,"to":454.466,"location":0,"content":"目前设置在层1是可以的"},{"from":454.966,"to":458.166,"location":0,"content":"但我们将其重命名以赋予更具意义的名字。"},{"from":459.266,"to":462.866,"location":0,"content":"为此，右键点击此处，选择重命名层"},{"from":463.566,"to":466.1,"location":0,"content":"并将其命名为 card_target_selector"},{"from":469.933,"to":472.3,"location":0,"content":"在遮罩中取消 layer 1 层的勾选"},{"from":473.7,"to":475.133,"location":0,"content":"然后勾选 layer 2"},{"from":477.566,"to":480.033,"location":0,"content":"并将此层重命名为 card_drop_area"},{"from":485.2,"to":489.066,"location":0,"content":"由于我们还未向这个Area2D添加任何碰撞形状"},{"from":489.066,"to":491.166,"location":0,"content":"所以会出现黄色警告标志"},{"from":491.866,"to":496.1,"location":0,"content":"现在我们点击加号，搜索并添加CollisionShape2D节点。"},{"from":498.7,"to":503.533,"location":0,"content":"对于形状，点击下拉菜单，添加一个新的RectangleShape2D。"},{"from":504.8,"to":507.966,"location":0,"content":"按下W键或点击这个图标进入移动模式。"},{"from":510.5,"to":512.866,"location":0,"content":"若返回选择模式或按下Q键"},{"from":513.3,"to":517,"location":0,"content":"我们可以拖动控制柄来确保碰撞形状完全覆盖卡片。"},{"from":517.633,"to":522.966,"location":0,"content":"至此，我们所需的初步设置就完成了，按Control+S保存场景。"},{"from":524.1,"to":527.366,"location":0,"content":"接下来我们可以向战斗场景中添加一些内容。"},{"from":527.833,"to":529.2,"location":0,"content":"切换到 battle 场景"},{"from":530,"to":533.866,"location":0,"content":"首先，让我们缩小视图以便更好地观察整体状况。"},{"from":534.633,"to":539.2,"location":0,"content":"选择 Battle 节点，为卡片放置区域添加一个Area2D节点。"},{"from":541.633,"to":544.766,"location":0,"content":"在这里，我们将其重命名为 CardDropArea"},{"from":546.666,"to":550.4,"location":0,"content":"在碰撞设置中，我们需要将其所在层改为 2"},{"from":551.333,"to":553.366,"location":0,"content":"因为这是一个卡片放置区域"},{"from":554.166,"to":556.566,"location":0,"content":"而对于遮罩层，则保留1层"},{"from":557,"to":559.5,"location":0,"content":"因为它应该作用于 card_target_selector 层"},{"from":560.766,"to":563.6,"location":0,"content":"同样地，我们也要为其添加碰撞形状。"},{"from":564.5,"to":567.466,"location":0,"content":"我们现在添加一个新的 CollisionShape2D节点。"},{"from":568.5,"to":572,"location":0,"content":"在形状设置下，同样是 RectangleShape2D"},{"from":573.433,"to":576.533,"location":0,"content":"我们可以拖动控制柄以确保它覆盖屏幕"},{"from":576.533,"to":578.433,"location":0,"content":"或游戏屏幕中我们想要的部分"},{"from":579.333,"to":583.066,"location":0,"content":"不过如果我们想要更精确的话，还可以采取其他方式。"},{"from":584.4,"to":587.466,"location":0,"content":"如果我们点击这个RectangleShape2D资源"},{"from":587.466,"to":591.066,"location":0,"content":"我们可以将其尺寸调整为填满整个屏幕宽度"},{"from":591.066,"to":593.466,"location":0,"content":"比如设置为256像素。"},{"from":595.1,"to":598.966,"location":0,"content":"对于高度，我们可以设置为大约屏幕高度的三分之二"},{"from":598.966,"to":600.466,"location":0,"content":"比如说100像素。"},{"from":601.666,"to":606.866,"location":0,"content":"再次强调，我们可以使用移动工具尝试将其定位以覆盖整个屏幕。"},{"from":608.566,"to":612.266,"location":0,"content":"但也可以直接点击“变换”属性，并计算出准确的位置"},{"from":613.4,"to":617.766,"location":0,"content":"因为我们需要将其宽度和高度分别进行 50% 的偏移"},{"from":620.1,"to":625.166,"location":0,"content":"因此，我们可以通过计算256除以2得到宽度的一半偏移量。"},{"from":626.466,"to":631.533,"location":0,"content":"同样地，高度的一半偏移量为100除以2，结果是50像素。"},{"from":632.433,"to":636.566,"location":0,"content":"这样一来，你就可以看到它正好适合整个屏幕宽度"},{"from":636.566,"to":638.966,"location":0,"content":"或者说与屏幕宽度完美契合。"},{"from":639.7,"to":643.633,"location":0,"content":"这对于卡片放置区域非常合适，现在我们保存场景"},{"from":644.566,"to":647.766,"location":0,"content":"接下来，我们可以转向用户界面（UI）的设计。"},{"from":648.366,"to":649.933,"location":0,"content":"再次选择战斗场景"},{"from":650.466,"to":652.633,"location":0,"content":"这次我们将添加一个画布层节点"},{"from":654.366,"to":656.4,"location":0,"content":"以确保UI在一个独立的层中。"},{"from":658,"to":661.3,"location":0,"content":"点击新增节点并将其重命名为Battle UI。"},{"from":663.6,"to":666.8,"location":0,"content":"在层设置中，请确保它设置为层 1"},{"from":666.8,"to":669.166,"location":0,"content":"这样它将在游戏本身之上渲染。"},{"from":670.433,"to":673.033,"location":0,"content":"在这个节点下添加一个新的子节点。"},{"from":673.766,"to":677.5,"location":0,"content":"对于卡片，我们可以模拟一种3D扇形排列效果。"},{"from":678.566,"to":680.266,"location":0,"content":"如果你对此感兴趣"},{"from":680.666,"to":683.433,"location":0,"content":"我会在下方链接一个非常好的教程视频。"},{"from":684.033,"to":687.566,"location":0,"content":"但为了简化操作，我们这里仅使用 H Box 容器。"},{"from":688.866,"to":690.666,"location":0,"content":"搜索 H Box 容器"},{"from":691.466,"to":693.9,"location":0,"content":"点击它并将其重命名为 Hand"},{"from":696.566,"to":700.133,"location":0,"content":"我们需要添加几张卡片，来看看实际效果如何。"},{"from":701.8,"to":703.9,"location":0,"content":"通过这个“实例化子场景”按钮"},{"from":704.8,"to":706.933,"location":0,"content":"我们可以添加卡片用户界面"},{"from":710,"to":714.833,"location":0,"content":"同时，通过按下Control + d，或者右键单击并选择复制"},{"from":716.066,"to":717.933,"location":0,"content":"我们可以添加三张卡片。"},{"from":718.733,"to":720.666,"location":0,"content":"你可以立刻看到这里有些问题"},{"from":721.7,"to":724.766,"location":0,"content":"我们看不到卡片上的文字和颜色矩形。"},{"from":728.233,"to":732.033,"location":0,"content":"那是因为 H Box容器正在控制其子元素的尺寸。"},{"from":732.966,"to":737,"location":0,"content":"如果我们想要确保所有卡片至少为25乘30像素"},{"from":737.766,"to":740.133,"location":0,"content":"我们需要回到 card_UI 场景中去。"},{"from":742.1,"to":743.733,"location":0,"content":"在卡片UI层级下"},{"from":743.733,"to":745.333,"location":0,"content":"我们已经设置了尺寸"},{"from":745.333,"to":747.6,"location":0,"content":"但对于使用容器来说这还不够"},{"from":747.6,"to":749.2,"location":0,"content":"还需要设置最小尺寸。"},{"from":750.433,"to":754.4,"location":0,"content":"那么，让我们也将此尺寸修改为25乘30像素。"},{"from":756.166,"to":759.533,"location":0,"content":"如果我们保存这个场景并返回到战斗场景"},{"from":759.533,"to":761.6,"location":0,"content":"你会发现视觉效果好多了。"},{"from":763,"to":766.1,"location":0,"content":"不过，手牌放在屏幕左上角并不理想"},{"from":766.866,"to":768.966,"location":0,"content":"所以我们先更改锚点预设。"},{"from":771.1,"to":773.666,"location":0,"content":"我们确保这个锚点设置为“底部居中”"},{"from":776.566,"to":779.433,"location":0,"content":"此外，在布局、变换设置中"},{"from":781,"to":784.566,"location":0,"content":"我们希望将尺寸改为大约150乘30像素。"},{"from":789.3,"to":793.166,"location":0,"content":"可以看到当我们改变尺寸时，位置会发生偏移。"},{"from":794.1,"to":797.166,"location":0,"content":"我们转到锚点预设并重新选择“底部居中”"},{"from":797.7,"to":800.7,"location":0,"content":"它会重新计算位置，现在看起来好多了。"},{"from":801.4,"to":804.133,"location":0,"content":"手牌区准备就绪，我们保存场景。"}]}