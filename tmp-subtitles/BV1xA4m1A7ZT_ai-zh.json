{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.6.0.4",
  "body": [
    {
      "from": 3.26,
      "to": 5.6,
      "sid": 1,
      "location": 2,
      "content": "欢迎回到golden的游戏实验室",
      "music": 0.0
    },
    {
      "from": 5.6,
      "to": 6.98,
      "sid": 2,
      "location": 2,
      "content": "在这段视频中",
      "music": 0.0
    },
    {
      "from": 6.98,
      "to": 9.47,
      "sid": 3,
      "location": 2,
      "content": "我们将创建本项目的基础部分",
      "music": 0.0
    },
    {
      "from": 9.47,
      "to": 11.39,
      "sid": 4,
      "location": 2,
      "content": "卡片拖动机制",
      "music": 0.0
    },
    {
      "from": 11.39,
      "to": 13.64,
      "sid": 5,
      "location": 2,
      "content": "在杀戮尖塔这款游戏中",
      "music": 0.0
    },
    {
      "from": 13.64,
      "to": 15.62,
      "sid": 6,
      "location": 2,
      "content": "我们有两种类型的卡片",
      "music": 0.0
    },
    {
      "from": 15.62,
      "to": 17.75,
      "sid": 7,
      "location": 2,
      "content": "一种是单目标指向型",
      "music": 0.0
    },
    {
      "from": 17.75,
      "to": 20.47,
      "sid": 8,
      "location": 2,
      "content": "另一种是非单目标指向型",
      "music": 0.0
    },
    {
      "from": 20.47,
      "to": 23.59,
      "sid": 9,
      "location": 2,
      "content": "我们先从较为简单的那一种开始",
      "music": 0.0
    },
    {
      "from": 23.59,
      "to": 25.9,
      "sid": 10,
      "location": 2,
      "content": "如果我开始拖动这张防守卡",
      "music": 0.0
    },
    {
      "from": 25.9,
      "to": 28.3,
      "sid": 11,
      "location": 2,
      "content": "并在手牌上方某个位置释放它",
      "music": 0.0
    },
    {
      "from": 28.3,
      "to": 31.08,
      "sid": 12,
      "location": 2,
      "content": "那么这张卡就会被使用",
      "music": 0.0
    },
    {
      "from": 31.3,
      "to": 33.23,
      "sid": 13,
      "location": 2,
      "content": "还有一种实现方式是",
      "music": 0.0
    },
    {
      "from": 33.23,
      "to": 35.78,
      "sid": 14,
      "location": 2,
      "content": "先用左键点击一下这张防守卡",
      "music": 0.0
    },
    {
      "from": 35.78,
      "to": 37.85,
      "sid": 15,
      "location": 2,
      "content": "然后在不按住左键的情况下",
      "music": 0.0
    },
    {
      "from": 37.85,
      "to": 38.78,
      "sid": 16,
      "location": 2,
      "content": "移动鼠标",
      "music": 0.0
    },
    {
      "from": 38.78,
      "to": 42.01,
      "sid": 17,
      "location": 2,
      "content": "再次点击时也可以完成放置",
      "music": 0.0
    },
    {
      "from": 42.23,
      "to": 46.51,
      "sid": 18,
      "location": 2,
      "content": "此外取消拖动动作也有两种方法",
      "music": 0.0
    },
    {
      "from": 46.97,
      "to": 48.79,
      "sid": 19,
      "location": 2,
      "content": "你可以通过右键点击",
      "music": 0.0
    },
    {
      "from": 48.79,
      "to": 51.25,
      "sid": 20,
      "location": 2,
      "content": "或者将卡片拖动至游戏区域下方",
      "music": 0.0
    },
    {
      "from": 51.25,
      "to": 53.11,
      "sid": 21,
      "location": 2,
      "content": "来取消此次操作",
      "music": 0.0
    },
    {
      "from": 53.11,
      "to": 57.01,
      "sid": 22,
      "location": 2,
      "content": "现在让我们看看在我们的游戏中是如何运作的",
      "music": 0.0
    },
    {
      "from": 57.01,
      "to": 57.91,
      "sid": 23,
      "location": 2,
      "content": "你可以看到",
      "music": 0.0
    },
    {
      "from": 57.91,
      "to": 60.95,
      "sid": 24,
      "location": 2,
      "content": "我们在顶部有一个很大的卡片放置区域",
      "music": 0.0
    },
    {
      "from": 60.95,
      "to": 64.61,
      "sid": 25,
      "location": 2,
      "content": "并且手中有三张处于初始状态的卡片",
      "music": 0.0
    },
    {
      "from": 64.61,
      "to": 67.13,
      "sid": 26,
      "location": 2,
      "content": "当我将鼠标悬停在一张卡片上",
      "music": 0.0
    },
    {
      "from": 67.13,
      "to": 68.81,
      "sid": 27,
      "location": 2,
      "content": "并左键单击一次时",
      "music": 0.0
    },
    {
      "from": 68.81,
      "to": 70.85,
      "sid": 28,
      "location": 2,
      "content": "卡片会进入拖动状态",
      "music": 0.0
    },
    {
      "from": 70.85,
      "to": 74.69,
      "sid": 29,
      "location": 2,
      "content": "我可以将卡片拖动到卡片放置区域上方",
      "music": 0.0
    },
    {
      "from": 74.69,
      "to": 77.36,
      "sid": 30,
      "location": 2,
      "content": "当我再次用左键点击时",
      "music": 0.0
    },
    {
      "from": 77.36,
      "to": 79.34,
      "sid": 31,
      "location": 2,
      "content": "卡片会被释放",
      "music": 0.0
    },
    {
      "from": 79.34,
      "to": 82.01,
      "sid": 32,
      "location": 2,
      "content": "并且我们能看到一条提示信息",
      "music": 0.0
    },
    {
      "from": 82.01,
      "to": 87.419,
      "sid": 33,
      "location": 2,
      "content": "在目标的卡片放置区域内使用卡片非常好",
      "music": 0.0
    },
    {
      "from": 87.419,
      "to": 89.729,
      "sid": 34,
      "location": 2,
      "content": "如果我们拖动另一张卡片",
      "music": 0.0
    },
    {
      "from": 89.729,
      "to": 92.219,
      "sid": 35,
      "location": 2,
      "content": "并在卡片放置区域下方释放",
      "music": 0.0
    },
    {
      "from": 92.219,
      "to": 94.93,
      "sid": 36,
      "location": 2,
      "content": "它会自动回到玩家的手牌中",
      "music": 0.0
    },
    {
      "from": 94.93,
      "to": 95.98,
      "sid": 37,
      "location": 2,
      "content": "同样的",
      "music": 0.0
    },
    {
      "from": 95.98,
      "to": 97.9,
      "sid": 38,
      "location": 2,
      "content": "如果我开始拖动这张卡片",
      "music": 0.0
    },
    {
      "from": 97.9,
      "to": 100.03,
      "sid": 39,
      "location": 2,
      "content": "将其拖过卡片放置区域后",
      "music": 0.0
    },
    {
      "from": 100.03,
      "to": 101.41,
      "sid": 40,
      "location": 2,
      "content": "再右键点击它",
      "music": 0.0
    },
    {
      "from": 101.41,
      "to": 103.75,
      "sid": 41,
      "location": 2,
      "content": "也会回到玩家的手牌中",
      "music": 0.0
    },
    {
      "from": 103.97,
      "to": 106.15,
      "sid": 42,
      "location": 2,
      "content": "这一功能运行良好",
      "music": 0.0
    },
    {
      "from": 106.15,
      "to": 108.65,
      "sid": 43,
      "location": 2,
      "content": "我们开始着手制作吧",
      "music": 0.0
    },
    {
      "from": 108.65,
      "to": 109.82,
      "sid": 44,
      "location": 2,
      "content": "打开项目",
      "music": 0.0
    },
    {
      "from": 109.82,
      "to": 112.4,
      "sid": 45,
      "location": 2,
      "content": "我们开始创建卡片拖动机制",
      "music": 0.0
    },
    {
      "from": 112.4,
      "to": 113.81,
      "sid": 46,
      "location": 2,
      "content": "对于卡片本身",
      "music": 0.0
    },
    {
      "from": 113.81,
      "to": 116.75,
      "sid": 47,
      "location": 2,
      "content": "我们将结合使用控制节点来展示它们",
      "music": 0.0
    },
    {
      "from": 116.75,
      "to": 119.3,
      "sid": 48,
      "location": 2,
      "content": "并使用一个二维区域节点来处理",
      "music": 0.0
    },
    {
      "from": 119.3,
      "to": 121.86,
      "sid": 49,
      "location": 2,
      "content": "卡片放置区域的逻辑",
      "music": 0.0
    },
    {
      "from": 122.31,
      "to": 124.46,
      "sid": 50,
      "location": 2,
      "content": "首先点击这个加号",
      "music": 0.0
    },
    {
      "from": 124.46,
      "to": 126.49,
      "sid": 51,
      "location": 2,
      "content": "新建一个场景",
      "music": 0.0
    },
    {
      "from": 126.49,
      "to": 129.01,
      "sid": 52,
      "location": 2,
      "content": "我们从用户界面节点作为根节点",
      "music": 0.0
    },
    {
      "from": 129.01,
      "to": 131.41,
      "sid": 53,
      "location": 2,
      "content": "开始添加一个控制节点",
      "music": 0.0
    },
    {
      "from": 131.41,
      "to": 132.55,
      "sid": 54,
      "location": 2,
      "content": "点击它",
      "music": 0.0
    },
    {
      "from": 132.55,
      "to": 135.88,
      "sid": 55,
      "location": 2,
      "content": "然后将其重命名为cardio i",
      "music": 0.0
    },
    {
      "from": 136.22,
      "to": 140.2,
      "sid": 56,
      "location": 2,
      "content": "接下来我们需要在这个节点下添加两个子节点",
      "music": 0.0
    },
    {
      "from": 140.2,
      "to": 142.93,
      "sid": 57,
      "location": 2,
      "content": "点击加号换CTRL加A",
      "music": 0.0
    },
    {
      "from": 142.93,
      "to": 146.15,
      "sid": 58,
      "location": 2,
      "content": "首先我们添加一个颜色矩形节点",
      "music": 0.0
    },
    {
      "from": 146.15,
      "to": 148.97,
      "sid": 59,
      "location": 2,
      "content": "这个颜色矩形将作为一个临时颜色",
      "music": 0.0
    },
    {
      "from": 148.97,
      "to": 151.97,
      "sid": 60,
      "location": 2,
      "content": "以便我们在调试阶段能够通过视觉差异",
      "music": 0.0
    },
    {
      "from": 151.97,
      "to": 154.23,
      "sid": 61,
      "location": 2,
      "content": "区分不同的状态",
      "music": 0.0
    },
    {
      "from": 154.69,
      "to": 158.62,
      "sid": 62,
      "location": 2,
      "content": "将颜色矩形重命名为color",
      "music": 0.0
    },
    {
      "from": 159.56,
      "to": 162.43,
      "sid": 63,
      "location": 2,
      "content": "然后再选中CAUI这个根节点",
      "music": 0.0
    },
    {
      "from": 162.43,
      "to": 164.14,
      "sid": 64,
      "location": 2,
      "content": "再次点击加号",
      "music": 0.0
    },
    {
      "from": 164.14,
      "to": 167.08,
      "sid": 65,
      "location": 2,
      "content": "添加一个标签节点",
      "music": 0.0
    },
    {
      "from": 168.3,
      "to": 169.7,
      "sid": 66,
      "location": 2,
      "content": "点击标签节点",
      "music": 0.0
    },
    {
      "from": 169.7,
      "to": 172.5,
      "sid": 67,
      "location": 2,
      "content": "并将其重命名为state",
      "music": 0.0
    },
    {
      "from": 172.84,
      "to": 174.72,
      "sid": 68,
      "location": 2,
      "content": "现在让我们放大一些",
      "music": 0.0
    },
    {
      "from": 174.72,
      "to": 177.66,
      "sid": 69,
      "location": 2,
      "content": "以便更好地查看情况",
      "music": 0.0
    },
    {
      "from": 178.469,
      "to": 181.549,
      "sid": 70,
      "location": 2,
      "content": "我们给CARUI设置一个合适的大小",
      "music": 0.0
    },
    {
      "from": 181.549,
      "to": 182.809,
      "sid": 71,
      "location": 2,
      "content": "转到布局",
      "music": 0.0
    },
    {
      "from": 182.809,
      "to": 185.14,
      "sid": 72,
      "location": 2,
      "content": "layout变换",
      "music": 0.0
    },
    {
      "from": 185.14,
      "to": 185.8,
      "sid": 73,
      "location": 2,
      "content": "Transform",
      "music": 0.0
    },
    {
      "from": 186.94,
      "to": 191.62,
      "sid": 74,
      "location": 2,
      "content": "将尺寸设置为类似25×30这样的大小",
      "music": 0.0
    },
    {
      "from": 193.14,
      "to": 195.8,
      "sid": 75,
      "location": 2,
      "content": "这样看起来就像一张卡片的样子",
      "music": 0.0
    },
    {
      "from": 197.48,
      "to": 201.64,
      "sid": 76,
      "location": 2,
      "content": "接下来确保颜色节点也继承这个大小",
      "music": 0.0
    },
    {
      "from": 202.92,
      "to": 204.26,
      "sid": 77,
      "location": 2,
      "content": "选择颜色节点",
      "music": 0.0
    },
    {
      "from": 205.7,
      "to": 209.66,
      "sid": 78,
      "location": 2,
      "content": "然后在锚点预设中选择整个矩形",
      "music": 0.0
    },
    {
      "from": 211.24,
      "to": 215.16,
      "sid": 79,
      "location": 2,
      "content": "在此期间我们可以将颜色改为更为悦目的色彩",
      "music": 0.0
    },
    {
      "from": 215.16,
      "to": 217.68,
      "sid": 80,
      "location": 2,
      "content": "比如深绿色",
      "music": 0.0
    },
    {
      "from": 219.18,
      "to": 222.74,
      "sid": 81,
      "location": 2,
      "content": "那么我们选择一个深绿色",
      "music": 0.0
    },
    {
      "from": 223.5,
      "to": 224.96,
      "sid": 82,
      "location": 2,
      "content": "就像这样的颜色",
      "music": 0.0
    },
    {
      "from": 226.22,
      "to": 227.42,
      "sid": 83,
      "location": 2,
      "content": "对于state标签",
      "music": 0.0
    },
    {
      "from": 228.56,
      "to": 231.84,
      "sid": 84,
      "location": 2,
      "content": "只需在文本属性中输入state",
      "music": 0.0
    },
    {
      "from": 232.24,
      "to": 236.82,
      "sid": 85,
      "location": 2,
      "content": "并确保其在水平和垂直轴上都居中对齐",
      "music": 0.0
    },
    {
      "from": 238.88,
      "to": 244.0,
      "sid": 86,
      "location": 2,
      "content": "同时请确保标签节点是从父节点继承尺寸",
      "music": 0.0
    },
    {
      "from": 244.549,
      "to": 248.37,
      "sid": 87,
      "location": 2,
      "content": "再次点击锚点预设并设置为全矩形",
      "music": 0.0
    },
    {
      "from": 248.53,
      "to": 251.49,
      "sid": 88,
      "location": 2,
      "content": "可以看到文本比卡片本身要大很多",
      "music": 0.0
    },
    {
      "from": 251.49,
      "to": 254.58,
      "sid": 89,
      "location": 2,
      "content": "这是我们接下来需要解决的问题",
      "music": 0.0
    },
    {
      "from": 254.58,
      "to": 257.7,
      "sid": 90,
      "location": 2,
      "content": "好的我们或许可以添加一个新的标签",
      "music": 0.0
    },
    {
      "from": 257.7,
      "to": 258.99,
      "sid": 91,
      "location": 2,
      "content": "设置资源",
      "music": 0.0
    },
    {
      "from": 258.99,
      "to": 260.97,
      "sid": 92,
      "location": 2,
      "content": "或者转到主题覆盖",
      "music": 0.0
    },
    {
      "from": 260.97,
      "to": 265.15,
      "sid": 93,
      "location": 2,
      "content": "在字体大小设置中更改这里的字体大小",
      "music": 0.0
    },
    {
      "from": 265.37,
      "to": 268.57,
      "sid": 94,
      "location": 2,
      "content": "但我们并不希望为游戏中显示的每一个文本",
      "music": 0.0
    },
    {
      "from": 268.57,
      "to": 270.31,
      "sid": 95,
      "location": 2,
      "content": "单独进行这样的操作",
      "music": 0.0
    },
    {
      "from": 270.31,
      "to": 273.75,
      "sid": 96,
      "location": 2,
      "content": "依靠主题来统一设置会更加简便",
      "music": 0.0
    },
    {
      "from": 273.75,
      "to": 276.39,
      "sid": 97,
      "location": 2,
      "content": "所以我们来创建一个新的主题",
      "music": 0.0
    },
    {
      "from": 276.39,
      "to": 279.2,
      "sid": 98,
      "location": 2,
      "content": "在文件系统中选择根目录",
      "music": 0.0
    },
    {
      "from": 279.2,
      "to": 282.02,
      "sid": 99,
      "location": 2,
      "content": "右键点击选择创建新资源",
      "music": 0.0
    },
    {
      "from": 282.02,
      "to": 284.32,
      "sid": 100,
      "location": 2,
      "content": "并搜索theme",
      "music": 0.0
    },
    {
      "from": 285.98,
      "to": 287.47,
      "sid": 101,
      "location": 2,
      "content": "添加新的主题",
      "music": 0.0
    },
    {
      "from": 287.47,
      "to": 290.55,
      "sid": 102,
      "location": 2,
      "content": "并将其命名为main theme",
      "music": 0.0
    },
    {
      "from": 290.89,
      "to": 291.99,
      "sid": 103,
      "location": 2,
      "content": "点击保存",
      "music": 0.0
    },
    {
      "from": 293.49,
      "to": 295.65,
      "sid": 104,
      "location": 2,
      "content": "你会看到屏幕底部出现了主题",
      "music": 0.0
    },
    {
      "from": 295.65,
      "to": 299.13,
      "sid": 105,
      "location": 2,
      "content": "面板里面充满了各种设置",
      "music": 0.0
    },
    {
      "from": 299.13,
      "to": 300.3,
      "sid": 106,
      "location": 2,
      "content": "预览等选项",
      "music": 0.0
    },
    {
      "from": 301.32,
      "to": 304.19,
      "sid": 107,
      "location": 2,
      "content": "但我们现在还不需要那些内容",
      "music": 0.0
    },
    {
      "from": 304.47,
      "to": 306.23,
      "sid": 108,
      "location": 2,
      "content": "因为在右侧的检查器中",
      "music": 0.0
    },
    {
      "from": 306.23,
      "to": 308.15,
      "sid": 109,
      "location": 2,
